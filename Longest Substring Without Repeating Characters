//Longest Substring Without Repeating Characters

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_set<char> val;
        int left = 0;
        int answer = 0;

        for(int right = 0; right<s.length(); right ++){
            while(val.count(s[right])){
                val.erase(s[left]);
                left++;
            }
            val.insert(s[right]);

            answer = max(answer, right-left +1);
        }
        return answer;

    }
};

