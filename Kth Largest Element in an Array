//Kth Largest Element in an Array

class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        priority_queue<int, vector<int>, greater<int>> val;


        for(int num : nums){
            val.push(num);
            if(val.size() > k){
                val.pop();
            }
        }
        return val.top();
    }
};

