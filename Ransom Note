// Ransom Note

class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {

        vector<int> ransomCount(26, 0);
        vector<int> magazineCount(26, 0);

        for(char ch : ransomNote){
            ransomCount[ch - 'a']++;
        }
        for(char ch : magazine){
            magazineCount[ch - 'a']++;
        }

        for(int i = 0; i<26; i++){
            if(ransomCount[i] > magazineCount[i]){
                return false;
            }
        }
        return true;
    }
};

/*
Input
ransomNote =
"a"
magazine =
"b"
Output
false
Expected
false
*/
