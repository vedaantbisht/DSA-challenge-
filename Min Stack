// Min Stack

class MinStack {
public:
    stack<int> TS;
    stack<int> MIN_TS;

    MinStack() {
        
    }

    void push(int value) {
        TS.push(value);

        if (MIN_TS.empty() || value <= MIN_TS.top()) {
            MIN_TS.push(value);
        } else {
            MIN_TS.push(MIN_TS.top());
        }
    }

    void pop() {
        TS.pop();
        MIN_TS.pop();
    }

    int top() {
        return TS.top();
    }

    int getMin() {
        return MIN_TS.top();
    }
};

