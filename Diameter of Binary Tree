//Diameter of Binary Tree

class Solution {
private:
    int diameter(TreeNode* root , int& diameter1){
        if(root == nullptr) return 0;
        int lh = diameter(root->left, diameter1);
        int rh = diameter(root->right, diameter1);
        diameter1 = max(diameter1 , lh + rh);
        return 1 + max(lh , rh);

    }
public:
    
    int diameterOfBinaryTree(TreeNode* root) {
        int diameter1 = 0;
        diameter(root , diameter1);
        return diameter1;
        
    }
};

