//Regular Expression Matching

class Solution {
public:

    int dp[25][25];

    bool solve(string& s, string& p, int i, int j) {

        if (i >= s.size() && j >= p.size())
            return true;

        if (j >= p.size())
            return false;

        if (dp[i][j] != -1)
            return dp[i][j];

        bool match = (i < s.size() &&
                     (s[i] == p[j] || p[j] == '.'));

        if (j + 1 < p.size() && p[j + 1] == '*') {

            return dp[i][j] =
                solve(s, p, i, j + 2) ||
                (match && solve(s, p, i + 1, j));
        }

        if (match) {
            return dp[i][j] = solve(s, p, i + 1, j + 1);
        }

        return dp[i][j] = false;
    }

    bool isMatch(string s, string p) {

        memset(dp, -1, sizeof(dp));

        return solve(s, p, 0, 0);
    }
};

