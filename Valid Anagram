//Valid Anagram

class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.length() != t.length())
            return false;

            vector<int> freq(26,0);

            for(char ch : s)
                freq[ch - 'a']++;
            
            for(char ch : t)
                freq[ch - 'a']--;

            for(int val : freq){
                if(val != 0)
                    return false;
            }

            return true;
    }
};

/*
Input
s ="anagram"
t ="nagaram"
Output
true
Expected
true
