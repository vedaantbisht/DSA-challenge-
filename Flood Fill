//Flood Fill


class Solution {
public:
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {

        int oldColor = image[sr][sc];

        if (oldColor == color) {
            return image;
        }

        queue<pair<int, int>> q;
        q.push({sr, sc});

        image[sr][sc] = color;

        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        while (!q.empty()) {

            pair<int, int> curr = q.front();
            q.pop();

            int row = curr.first;
            int col = curr.second;

            for (int i = 0; i < 4; i++) {

                int nRow = row + dr[i];
                int nCol = col + dc[i];

                if (nRow >= 0 && nRow < image.size() &&
                    nCol >= 0 && nCol < image[0].size() &&
                    image[nRow][nCol] == oldColor) {

                    image[nRow][nCol] = color;
                    q.push({nRow, nCol});
                }
            }
        }

        return image;
    }
};

