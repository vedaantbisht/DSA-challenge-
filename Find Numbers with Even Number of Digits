#include<iostream>
#include<vector>
#include<string>
class Solution {
public:
    int findNumbers(std::vector<int>& nums) {
        int count = 0;
    

        for (int num : nums){
            if(std::to_string(num).length()%2==0){
                count++;
            }
        }
        return count;
    }    
};

