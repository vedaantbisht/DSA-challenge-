// Linked List Cycle

class Solution {
public:
    bool hasCycle(ListNode *head) {
        unordered_set<ListNode*> val;

        while(head !=   NULL){

            if(val.find(head) != val.end()){
                return true;
            }

            val.insert(head);
            head = head-> next;
        
        }
        return false;
    }
};

