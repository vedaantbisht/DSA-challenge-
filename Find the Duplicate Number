//Find the Duplicate Number1

class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        int slow= nums[0];
        int fast = nums[0];

        do{
            slow = nums[slow];
            fast = nums[nums[fast]];
        }
        while(slow != fast);
        int ptr = nums[0];
        while(ptr != slow){
            ptr = nums[ptr];
            slow = nums[slow];
        }
        return slow; 
    }
};
