//Product of Array Except Self

class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {

        int n = nums.size();
        vector<int> answer(n);

        for(int i = 0; i < n; i++) {

            int p = 1;

            for(int j = 0; j < n; j++) {

                if(i != j) {
                    p *= nums[j];
                }
            }

            answer[i] = p;
        }

        return answer;
    }
};

